# PostgreSQL (usado por docker-compose.yml)
POSTGRES_USER=almacen
POSTGRES_PASSWORD=almacen123
POSTGRES_DB=almacen
# Nota: se usa 5433 por si hay un PostgreSQL local en el 5432
POSTGRES_PORT=5433

# Conexion de la API a la base de datos
DATABASE_URL=postgresql+psycopg://almacen:almacen123@localhost:5433/almacen

# Login del sistema (usuario y contraseña)
AUTH_USER=mdpn
AUTH_PASSWORD=A2026i29
# Clave para firmar los tokens (cambiala)
AUTH_SECRET_KEY=cambia-esta-clave-secreta

# Stock minimo para alertas del dashboard
MIN_STOCK_THRESHOLD=12

# Nombre de la entidad que aparece en reportes
ENTITY_NAME=Municipalidad Distrital de Pueblo Nuevo - Chincha