# PostgreSQL (usado por docker-compose.yml)
POSTGRES_USER=almacen
POSTGRES_PASSWORD=almacen123
POSTGRES_DB=almacen
# Nota: se usa 5433 por si hay un PostgreSQL local en el 5432
POSTGRES_PORT=5433

# Conexion de la API a la base de datos
DATABASE_URL=postgresql+psycopg://almacen:almacen123@localhost:5433/almacen